BETTER_AUTH_SECRET=your-secret-key-here-min-32-bytes
BETTER_AUTH_BASE_URL=http://localhost:8788

# Frontend origin (used for redirecting auth errors back to UI)
APP_BASE_URL=http://localhost:5173

# Database (recommended on Vercel): Turso/libSQL
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Local dev fallback
DATABASE_URL=file:./dev.db
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
# Optional: Cloudflare Turnstile captcha for publish-claim start.
# If set, /api/publish/claim/start requires a captcha token.
TURNSTILE_SECRET_KEY=

# Optional: Upstash Redis for distributed rate limiting (recommended on Vercel).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: restrict CORS origins (comma-separated). If unset, defaults to
# APP_BASE_URL + localhost dev origins.
CORS_ALLOWED_ORIGINS=

# Optional: Vercel Blob storage for snapshots (recommended on Vercel).
# If set, snapshots are uploaded to Blob and downloaded to /tmp on demand.
BLOB_READ_WRITE_TOKEN=
PORT=8788
