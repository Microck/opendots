{
  "name": "opendots-backend",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch src --ext ts,js,mjs,cjs,json --exec \"node --env-file=.env --import tsx/esm src/server.ts\"",
    "build": "tsc --noEmit",
    "lint": "eslint src || true",
    "smoke:api": "node --import tsx/esm src/scripts/smokeCheck.ts",
    "db:generate": "drizzle-kit generate --config drizzle.turso.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.turso.config.ts",
    "db:generate:sqlite": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate:sqlite": "drizzle-kit migrate --config drizzle.config.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^9.0.0",
    "@upstash/redis": "^1.34.4",
    "@vercel/blob": "^0.27.0",
    "@libsql/client": "^0.15.15",
    "adm-zip": "^0.5.16",
    "ajv": "^8.17.1",
    "archiver": "^7.0.1",
    "better-auth": "^1.4.18",
    "comment-json": "^4.5.1",
    "drizzle-orm": "^0.45.1",
    "fastify": "^5.0.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.1",
    "octokit": "^5.0.5"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/archiver": "^7.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9.0.0",
    "nodemon": "^3.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.4.0"
  }
}
