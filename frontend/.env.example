# Optional: Cloudflare Turnstile site key for the landing-page publish flow.
# If set, a captcha widget appears and the API requires a captcha token.
VITE_TURNSTILE_SITE_KEY=

# Optional: backend API origin (e.g. https://api.opendots.me).
# If omitted, the frontend uses same-origin /api/* (dev proxy still works).
VITE_API_BASE_URL=

# Optional: public site origin used when generating AI install/publish prompts.
# If omitted, the frontend uses window.location.origin.
VITE_SITE_BASE_URL=
